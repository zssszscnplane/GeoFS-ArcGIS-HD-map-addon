// ==UserScript==
// @name         ArcGIS卫星地图（原版稳 + 控制台）
// @namespace    https://www.geo-fs.com/geofs.php?v=3.9
// @version      3.0
// @description  原版稳定ArcGIS | 按D键控制台 | 开源免费 | 禁止倒卖
// @author       我是小猪05
// @match        https://www.geo-fs.com/geofs.php*
